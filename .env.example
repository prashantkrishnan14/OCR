# ERPNext Configuration
ERPNEXT_URL=https://erp.example.com
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract
# Leave empty to use system default

# Optional: Google Vision API
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# Leave empty to use Tesseract only

# OCR Settings
OCR_PROVIDER=tesseract
# Options: tesseract, google_vision

# Fuzzy Matching Thresholds
VENDOR_MATCH_THRESHOLD=75
# Minimum score (0-100) for vendor match
VENDOR_AUTO_APPROVE_THRESHOLD=85
# Auto-approve above this score

# Image Preprocessing
ENABLE_PREPROCESSING=true
DESKEW_ENABLED=true
DENOISE_ENABLED=true

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR
